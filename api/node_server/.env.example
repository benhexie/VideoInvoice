PORT=8080
RUST_AI_URL=http://localhost:3000/api/ai
PDF_ENGINE_URL=http://localhost:5000

# Firebase Admin Configuration (Required for cloud deployments like Railway)
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Web API Key (public identifier, not a secret) — used server-side to
# verify email/password credentials via the Identity Toolkit REST API for the
# web account-deletion page. Find it in Firebase Console > Project Settings >
# General > Web API Key, or as "current_key" in app/google-services.json.
FIREBASE_WEB_API_KEY=your_web_api_key_here